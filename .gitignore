data/derived_precip1/
data/derived_maxh24/

# Raw NASA POWER hourly meteorological data (archived copy on Zenodo)
data/raw/nasapower_maravalia/hourly/*.rds
data/raw/nasapower_australia/hourly/*.rds

# R runtime & history
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Python cache
__pycache__/
*.pyc

