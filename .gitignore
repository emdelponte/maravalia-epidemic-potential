outputs/figures/*
!outputs/figures/.gitkeep
outputs/models/*
!outputs/models/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
outputs/tables_v2_precip1/
outputs/tables_v2_maxh24/

